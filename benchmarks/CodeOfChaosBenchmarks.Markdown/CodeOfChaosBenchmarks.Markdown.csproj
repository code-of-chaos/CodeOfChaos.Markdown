        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\CodeOfChaos.Markdown.Shared\CodeOfChaos.Markdown.Shared.csproj" />
      <ProjectReference Include="..\..\src\CodeOfChaos.Markdown\CodeOfChaos.Markdown.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Benchmarks\MarkdownBenchmark.md">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <DependentUpon>MarkdownBenchmark.cs</DependentUpon>
      </None>
    </ItemGroup>

</Project>
