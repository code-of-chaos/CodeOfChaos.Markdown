@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using CodeOfChaos.Markdown.Parsers.Blazor.Services
@using CodeOfChaos.Markdown.Syntax.Nodes
@using CodeOfChaos.Markdown.Parsers.Langs.Blazor
@using Microsoft.Extensions.DependencyInjection

@namespace CodeOfChaos.Markdown.Parsers.NodeVisitors
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inherits BaseMarkdownSyntaxNodeVisitor<TagMdSyntaxNode>

@inject IServiceProvider ServiceProvider

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
@if (TagLinkProvider is not null && TagLinkProvider.TryGetTagLink(SyntaxNode.Content, out string? link)) {
    <a href="@link" target="_blank" rel="noopener noreferrer" class="md-tag md-tag-@(SyntaxNode.Content)">
        @("#")@SyntaxNode.Content
    </a>
}
else {
    <span class="md-tag md-tag-@(SyntaxNode.Content)">
        @("#")@SyntaxNode.Content
    </span>
}

<style>
    .md-tag {
        display: inline-block;
        padding: 0.125rem 0.375rem; 
        border-radius: 0.75rem;

        /* Replace these with your actual design tokens/colors */
        background-color: #f3f4f6;
        color: #111827;
    }
</style>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    private ITagLinkProvider? TagLinkProvider { get; set; }

    protected override void OnInitialized() {
        base.OnInitialized();
        TagLinkProvider = ServiceProvider.GetService<ITagLinkProvider>();
    }
}

