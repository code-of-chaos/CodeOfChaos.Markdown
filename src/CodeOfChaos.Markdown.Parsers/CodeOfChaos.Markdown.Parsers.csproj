<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Source-generated DI registration files are public and currently emitted without XML docs. -->
        <NoWarn>$(NoWarn);1591</NoWarn>
        <!-- Package metadata -->
        <PackageId>CodeOfChaos.Markdown.Parsers</PackageId>
        <Description>Markdown Parsers for C# and DotNet</Description>
        <PackageTags>Markdown;Parsing;Library</PackageTags>
    </PropertyGroup>
    
  <ItemGroup>
      <PackageReference Include="CodeOfChaos.Extensions.MicrosoftLogging" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="CodeOfChaos.Extensions.DependencyInjection" />
      <PackageReference Include="CodeOfChaos.Extensions.DependencyInjection.Generators">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>analyzers</IncludeAssets>
      </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeOfChaos.Markdown.Editors\CodeOfChaos.Markdown.Editors.csproj" />
    <ProjectReference Include="..\CodeOfChaos.Markdown.Shared\CodeOfChaos.Markdown.Shared.csproj" />
    <ProjectReference Include="..\CodeOfChaos.Markdown.Syntax\CodeOfChaos.Markdown.Syntax.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <UpToDateCheckInput Remove="NodeVisitors\ScriptingExpression\ScriptingExpressionBlazorSyntaxNodeVisitor.razor" />
    <UpToDateCheckInput Remove="NodeVisitors\ScriptingBody\ScriptingBodyBlazorSyntaxNodeVisitor.razor" />
  </ItemGroup>
</Project>


