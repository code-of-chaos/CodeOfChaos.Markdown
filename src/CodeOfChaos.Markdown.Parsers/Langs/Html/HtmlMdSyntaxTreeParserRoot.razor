@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using CodeOfChaos.Markdown.Config
@using CodeOfChaos.Markdown.Parsers.Blazor
@using CodeOfChaos.Markdown.Parsers.Langs.Blazor
@using CodeOfChaos.Markdown.Syntax
@using CodeOfChaos.Markdown.Syntax.Nodes

@namespace CodeOfChaos.Markdown.Parsers.Langs.Html
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IBlazorMdComponentRenderer ComponentConverter
@inject IMarkdownConfig MarkdownConfig
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<CascadingValue Value="@RenderContext">
    @ComponentConverter.RenderRootComponents(SyntaxTree.VisitTopLevelNodes())

    @if (SyntaxTree.TryGetCachedChildrenByType(out IEnumerable<FootnoteDescriptionMdSyntaxNode>? footnoteDescriptions)) {
        if (MarkdownConfig.HtmlRendererFootnoteWrapperType is { } footnoteWrapperType) {
            <DynamicComponent
                Type="@footnoteWrapperType"
                Parameters="@GetFootnoteWrapperParameters(footnoteDescriptions)"/>
        }
    }
</CascadingValue>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public IMdSyntaxTree SyntaxTree { get; set; } = MdSyntaxTree.Empty;
    private MdRenderContext RenderContext { get; } = MdRenderContext.NonInteractive;

    private Dictionary<string, object> GetFootnoteWrapperParameters(IEnumerable<FootnoteDescriptionMdSyntaxNode> footnoteDescriptions) => new() {
        ["ChildContent"] = ComponentConverter.RenderRootComponentsWithSkipped(footnoteDescriptions),
    };
}