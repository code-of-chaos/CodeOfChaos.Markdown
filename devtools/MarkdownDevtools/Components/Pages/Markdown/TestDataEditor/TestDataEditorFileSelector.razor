@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using CodeOfChaos.Markdown
@using CodeOfChaos.Markdown.Syntax
@using CodeOfChaosTests.Shared

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject MdTestDataProvider MdTestDataProvider
@inject ILogger<TestDataEditorFileSelector> Logger
@inject IMarkdownParser MarkdownParser
@inject ISnackbar Snackbar

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudContainer MaxWidth="MaxWidth.Small">
    <MudStack Spacing="2" Class="pa-4">

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="@ReInterpretAllFilesAsync">
            Process all files
        </MudButton>

        @if (_isLoading) {
            <MudText>Loading files...</MudText>
        }
        else if (_fileNames == null) {
            <MudText Color="Color.Error">Failed to load files</MudText>
        }
        else if (_fileNames.Length == 0) {
            <MudText Color="Color.Secondary">No files found</MudText>
        }
        else {
            <MudText Typo="Typo.h6" Class="mb-2">Test Data Files</MudText>

            <MudPaper Class="pa-2" Style="max-height:75vh; overflow-y:auto;">
                @foreach (string fileName in _fileNames) {
                    <MudPaper Class="mb-2" Outlined="true">

                        <!-- File Header -->
                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween"
                                  Class="pa-3">

                            <MudText Typo="Typo.subtitle1">@fileName</MudText>

                            <MudIconButton Icon="@(
                                                 IsFileExpanded(fileName)
                                                     ? Icons.Material.Filled.ExpandMore
                                                     : Icons.Material.Filled.ChevronRight)"
                                           OnClick="@(() => ToggleFileExpanded(fileName))"/>
                        </MudStack>

                        @if (IsFileExpanded(fileName)) {
                            <MudDivider/>

                            <MudStack Class="pa-2" Spacing="1">

                                @if (fileTestData.TryGetValue(fileName, out List<MdTestData>? tests)) {
                                    if (tests?.Any() != true) {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            No tests found in this file
                                        </MudText>
                                    }
                                    else {
                                        <MudText Typo="Typo.caption">
                                            Tests (@tests.Count):
                                        </MudText>

                                        @foreach (MdTestData test in tests) {
                                            <MudPaper Class="pa-2"
                                                      Style="cursor:pointer"
                                                      Outlined="true"
                                                      @onclick="() => OnTestClick(fileName, test)">

                                                <MudText Typo="Typo.subtitle2">
                                                    @test.Id
                                                </MudText>

                                                @if (!string.IsNullOrWhiteSpace(test.MdString)) {
                                                    <MudText Typo="Typo.body2"
                                                             Style="white-space:pre-wrap; max-height:60px; overflow:hidden;">
                                                        @test.MdString
                                                    </MudText>
                                                }
                                            </MudPaper>
                                        }
                                    }
                                }
                                else if (loadingFiles.Contains(fileName)) {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                                }
                                else {
                                    <MudText Color="Color.Error" Typo="Typo.body2">
                                        Failed to load tests
                                    </MudText>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                }
            </MudPaper>
        }
    </MudStack>
</MudContainer>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public EventCallback<(string fileName, string testId)> OnTestSelected { get; set; }

    private string[]? _fileNames;
    private readonly Dictionary<string, List<MdTestData>?> fileTestData = new();
    private readonly HashSet<string> expandedFiles = new();
    private readonly HashSet<string> loadingFiles = new();
    private bool _isLoading = true;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override void OnInitialized() {
        try {
            _fileNames = MdTestDataProvider.TryGetFileNames();
        }
        catch (Exception ex) {
            Logger.LogError(ex, "Error loading file names");
            _fileNames = null;
        }
        finally {
            _isLoading = false;
        }
    }

    public async Task RefreshFileData(string? specificFileName = null) {
        if (specificFileName != null) {
            // Refresh specific file data
            if (!fileTestData.Remove(specificFileName)) return;

            if (IsFileExpanded(specificFileName)) await LoadFileTestData(specificFileName);
            return;
        }

        // Refresh all files
        try {
            _isLoading = true;
            StateHasChanged();

            _fileNames = MdTestDataProvider.TryGetFileNames();
            fileTestData.Clear();

            // Reload expanded files
            List<string> expandedFilesCopy = expandedFiles.ToList();
            foreach (string fileName in expandedFilesCopy) {
                if (_fileNames?.Contains(fileName) == true) {
                    await LoadFileTestData(fileName);
                }
                else {
                    expandedFiles.Remove(fileName);
                }
            }
        }
        finally {
            _isLoading = false;
            StateHasChanged();
        }
    }


    private bool IsFileExpanded(string fileName) => expandedFiles.Contains(fileName);

    private async Task ToggleFileExpanded(string fileName) {
        if (IsFileExpanded(fileName)) {
            expandedFiles.Remove(fileName);
        }
        else {
            expandedFiles.Add(fileName);
            await LoadFileTestData(fileName);
        }
    }

    private async Task LoadFileTestData(string fileName) {
        if (fileTestData.ContainsKey(fileName) || loadingFiles.Contains(fileName))
            return;

        try {
            loadingFiles.Add(fileName);
            StateHasChanged();

            List<MdTestData>? testData = await MdTestDataProvider.TryGetXmlMdTestDataAsync(fileName);
            fileTestData[fileName] = testData;
        }
        catch (Exception ex) {
            Logger.LogError(ex, "Error loading test data for file {FileName}", fileName);
            fileTestData[fileName] = null;
        }
        finally {
            loadingFiles.Remove(fileName);
            StateHasChanged();
        }
    }

    private async Task OnTestClick(string fileName, MdTestData testData) {
        Logger.Information("test {testID} clicked", testData.Id);
        await OnTestSelected.InvokeAsync((fileName, testData.Id));
    }

    private async Task ReInterpretAllFilesAsync() {
        try {
            if (_fileNames is null) return;

            foreach (string fileName in _fileNames) {
                List<MdTestData>? testData =
                    await MdTestDataProvider.TryGetXmlMdTestDataAsync(fileName);

                if (testData is null) continue;

                foreach (MdTestData mdTestData in testData) {
                    IMdSyntaxTree tree = mdTestData.MdSyntaxTree;

                    using var memoryStream = new MemoryStream();
                    await MarkdownParser.Json.DeserializeToJsonStreamAsync(memoryStream, tree);

                    memoryStream.Position = 0;
                    string json = await new StreamReader(memoryStream).ReadToEndAsync();
                    mdTestData.ExpectedJsonString = json;

                    mdTestData.ExpectedMarkdown =
                        MarkdownParser.Markdown.DeserializeToString(tree);
                }

                await MdTestDataProvider.TryWriteXmlMdTestDataAsync(fileName, testData);
            }

            Snackbar.Add("All files processed", Severity.Success);
        }
        catch (Exception e) {
            Logger.LogError(e, "Error processing all files");
            Snackbar.Add("Error processing all files. Check logs.", Severity.Error);
        }
    }
}