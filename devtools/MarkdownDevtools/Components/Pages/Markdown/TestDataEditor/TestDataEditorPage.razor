@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/markdown/testdata-editor"
@rendermode InteractiveServer

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@

<MudPaper>
    <MudStack Row>
        <TestDataEditorDataEntry
            @ref="_editorDataComponent"
            OnSave="@HandleOnSave"/>
        <TestDataEditorFileSelector
            @ref="_fileSelectorComponent"
            OnTestSelected="@HandleTestSelected"/>
    </MudStack>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private TestDataEditorDataEntry? _editorDataComponent;
    private TestDataEditorFileSelector? _fileSelectorComponent;

    private async Task HandleTestSelected((string fileName, string testId) selection) {
        // Trigger the editor to update and fetch the selected test
        StateHasChanged();

        // Automatically fetch the test data
        if (_editorDataComponent != null) {
            await _editorDataComponent.LoadTestData(selection.fileName, selection.testId);
        }
    }

    private async Task HandleOnSave() {
        // Refresh the file selector to show updated data
        if (_fileSelectorComponent != null) {
            await _fileSelectorComponent.RefreshFileData();
        }

        await InvokeAsync(StateHasChanged);
    }
}

